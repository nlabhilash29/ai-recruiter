# The API boots without these keys. Routes that call a missing provider return HTTP 503
# naming the variable. AI_STUB=1 skips Groq, OpenAI, and ElevenLabs for a local demo.
OPENAI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Questions and scoring. openai/gpt-oss-120b supports JSON schema on Groq.
# Do not set llama3-70b-8192 or llama-3.3-70b-versatile; both were removed.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# eleven_monolingual_v1 was removed. Leave these unless you have a reason to change them.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Recruiter pages are open unless this is true. RECRUITER_PASSCODE alone does not lock them.
# RECRUITER_AUTH_REQUIRED=true
RECRUITER_AUTH_REQUIRED=

# Used only when RECRUITER_AUTH_REQUIRED is true.
RECRUITER_PASSCODE=

# Render Postgres URLs (postgres://...) are normalized automatically.
# Omit this locally to use SQLite at ./test.db
DATABASE_URL=sqlite:///./test.db

# Optional extra browser origins, comma-separated.
# The Vercel production domain and localhost:3000 are already allowed.
CORS_ORIGINS=

# Set to 1 to run without OpenAI, Groq, or ElevenLabs (local smoke tests).
# AI_STUB=1
