# Copy to backend/.env and fill in the keys you have.
# The API boots without them. Calls that need a missing key return HTTP 503.
# AI_STUB=1 skips Groq, OpenAI, and ElevenLabs for a local demo. Leave it unset in production.

OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
DATABASE_URL=sqlite:///./test.db
# AI_STUB=1
